<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.dwstudio</groupId>
    <artifactId>dwstudio-server</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>DataWeave Studio Server</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 8 target: the DW runtime artifacts ship as Java 8 bytecode
             (verified: major version 52). Targeting 8 here makes the whole
             dwstudio-server JAR runnable on any JRE 8+, including the older
             corporate JREs MuleSoft devs often have for Mule 4.x. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <scala.version>2.12.18</scala.version>
        <scala.binary.version>2.12</scala.binary.version>
        <weave.version>2.11.0-20251023</weave.version>
    </properties>

    <repositories>
        <repository>
            <id>mule-releases</id>
            <url>https://repository.mulesoft.org/nexus/content/repositories/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>${scala.version}</version>
        </dependency>

        <!-- DataWeave runtime + most useful core modules. Match the version
             we currently bundle so behavior is identical. -->
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>runtime</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>core-modules</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <!-- java-module enables `import java!org::package::Klass` for direct
             JVM interop. Lets users call any class on the classpath. -->
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>java-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>yaml-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>ndjson-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <!-- Optional format modules that the standalone DW runtime supports
             when present on the classpath. Bundling them gives the app
             parity with the MuleSoft docs' "supported formats" list:
             application/xlsx, application/avro, application/protobuf,
             application/flatfile (incl. COBOL Copybook + Fixed Width). -->
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>excel-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>avro-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>protobuf-module</artifactId>
            <version>${weave.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>flatfile-module</artifactId>
            <version>${weave.version}</version>
        </dependency>

        <!-- dw::test support. These carry their own date stamps rather than
             ${weave.version}: the engine we pin (2.11.0-20251023) has no matching
             build of these three, but the 2.11 line is source-compatible.

             All three are required and each for a different reason:
               data-weave-testing-framework  dw::test::Tests   (describedBy / in)
               assertions                    dw::test::Asserts (must / equalTo)
               file-module                   dw::io::file::FileSystem, which the
                                             framework's own internals import.

             file-module must be a real dependency, not a hot-added classpath jar:
             its native functions are registered at engine startup, and adding the
             jar late resolves the DWL modules but leaves the natives missing
             ("Unable to find native module file"). -->
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>data-weave-testing-framework</artifactId>
            <version>2.11.0-20251202</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>assertions</artifactId>
            <version>2.11.0-20251202</version>
        </dependency>
        <dependency>
            <groupId>org.mule.weave</groupId>
            <artifactId>file-module</artifactId>
            <version>2.11.0-20251008</version>
        </dependency>

        <!-- Tiny JSON parser/encoder. jackson would be heavier; we only need
             4 ops on flat structures so we use minimal-json. -->
        <dependency>
            <groupId>com.eclipsesource.minimal-json</groupId>
            <artifactId>minimal-json</artifactId>
            <version>0.9.5</version>
        </dependency>

        <!-- Log4j 2 provider. excel-module → Apache POI 5.x ships log4j-api
             but expects the host app to provide log4j-core. Without it,
             POI's first log call writes "Log4j API could not find a logging
             provider" — and on some JVMs that line lands on STDOUT, which
             breaks our newline-delimited JSON protocol. Bundling log4j-core
             satisfies the API; our log4j2.xml (src/main/resources) routes
             all output to STDERR at WARN, and Rust nulls stderr, so the
             user never sees it. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
        </dependency>

        <!-- Force commons-io 2.18.0. POI 5.4.0 needs the new
             BoundedInputStream.builder() static added in 2.16+; Maven's
             nearest-wins picked an older 2.15.1 transitively pulled by
             another module, causing NoSuchMethodError when reading any
             .xlsx. Declaring it explicitly here makes our version "nearest"
             (depth 1) so it always wins. -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>

        <!-- Snappy codec for Avro. Real-world .avro files coming out of
             Kafka / Hadoop / Spark almost always use snappy compression.
             The avro-module ships the codec lookup but not the snappy
             implementation, so without this any snappy-compressed file
             throws "Unrecognized codec: snappy". snappy-java bundles its
             own native libs for Windows / macOS / Linux on x64 + arm64. -->
        <dependency>
            <groupId>org.xerial.snappy</groupId>
            <artifactId>snappy-java</artifactId>
            <version>1.1.10.7</version>
        </dependency>
        <!-- zstandard codec — modern alternative to snappy, gaining ground
             in newer pipelines. Same ~1MB cost, worth having on hand. -->
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>1.5.6-8</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.9.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <!-- Force Scala compiler to emit Java 8 bytecode too. -->
                    <args>
                        <arg>-target:jvm-1.8</arg>
                    </args>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>dwstudio-server</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.dwstudio.DwServer</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
