<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for the Microsoft Store build of DataWeave Studio.
  Built into an .msix by scripts/pack-msix.ps1 (via the winapp CLI).

  IDENTITY: these are the REAL values assigned by Partner Center — do not edit them.
  Name/Publisher/PublisherDisplayName must match the Store exactly or package upload
  is rejected. Publisher is the Store's GUID, not a human name.

    Store ID   9NWD4L4J7D92
    Listing    https://apps.microsoft.com/detail/9NWD4L4J7D92
    PFN        AshutoshVijay.DataWeaveStudio_5e8d9xn33hk2a

  The Store strips any signature and re-signs with its own certificate, so the
  dev cert in scripts/pack-msix.ps1 is only for installing locally. That cert's
  subject is generated from Publisher above — if you change identity, delete
  devcert.pfx so it is regenerated, or local installs will fail to validate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop desktop6 rescap">

  <Identity
    Name="AshutoshVijay.DataWeaveStudio"
    Publisher="CN=C350977C-C8E1-4F02-9374-0394BA122B4A"
    Version="2.4.0.0" />

  <Properties>
    <DisplayName>DataWeave Studio</DisplayName>
    <PublisherDisplayName>Ashutosh Vijay</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="dataweaveStudio"
      Executable="app.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DataWeave Studio"
        Description="A fast, local workbench for DataWeave 2.0"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png">
        <uap:DefaultTile Wide310x150Logo="Assets\WideTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust desktop app: runs outside AppContainer, so it can spawn the
         bundled Java engine/javac and bind the loopback MCP server. internetClient
         covers the Maven Central jar fetch. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
