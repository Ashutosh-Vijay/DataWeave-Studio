  "cases": [],
  "solution": "%dw 2.0\noutput application/json\n---\n[ \"hello\" indexOf \"l\", \"hello\" lastIndexOf \"l\", \"hello\" indexOf \"z\" ]",
  "explanation": {
    "approach": "Positions start at 0. A search that finds nothing returns -1, not null.",
    "snippets": [
      {
        "label": "The answer",
        "script": "%dw 2.0\noutput application/json\n---\n[ \"hello\" indexOf \"l\", \"hello\" lastIndexOf \"l\", \"hello\" indexOf \"z\" ]",
        "expect": {
          "output": "[ 2, 3, -1 ]"
        },
        "note": "h is 0, e is 1, the first l is 2."
      }
