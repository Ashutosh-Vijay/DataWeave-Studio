{
  "id": "mcq-descendants-selector",
  "unit": "select-and-shape",
  "mode": "choice",
  "tier": "medium",
  "title": "What does this return?",
  "topics": [
    "..",
    "selectors"
  ],
  "examObjective": "Predicting the result of core DataWeave functions",
  "prompt": "Read the script and the payload. **What does it return?**",
  "inputMime": "application/json",
  "outputMime": "application/json",
  "given": {
    "script": "%dw 2.0\noutput application/json\n---\npayload..id",
    "payload": "{\"a\":{\"id\":1,\"b\":{\"id\":2}},\"c\":[{\"id\":3}]}"
  },
  "choice": {
    "kind": "which-output",
    "answer": 1,
    "options": [
      "[ 1 ]",
      "[ 1, 2, 3 ]",
      "[ [ 1, 2 ], [ 3 ] ]",
      "[ 1, 3 ]"
    ]
  },
  "cases": [],
  "solution": "%dw 2.0\noutput application/json\n---\npayload..id",
  "explanation": {
    "approach": "`..` searches every level below the current one, including inside arrays, and returns one flat Array of everything it finds, in document order.",
    "snippets": [
      {
        "label": "The answer",
        "script": "%dw 2.0\noutput application/json\n---\npayload..id",
        "payload": "{\"a\":{\"id\":1,\"b\":{\"id\":2}},\"c\":[{\"id\":3}]}",
        "expect": {
          "output": "[ 1, 2, 3 ]"
        },
        "note": "All three depths, one flat list."
      },
      {
        "label": "One level only",
        "script": "%dw 2.0\noutput application/json\n---\npayload.a.id",
        "payload": "{\"a\":{\"id\":1,\"b\":{\"id\":2}},\"c\":[{\"id\":3}]}",
        "expect": {
          "output": "1"
        },
        "note": "The single-dot selector does not go deeper."
      }
    ]
  }
}
