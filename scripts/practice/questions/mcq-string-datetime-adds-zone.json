{
  "id": "mcq-string-datetime-adds-zone",
  "unit": "date-arithmetic",
  "mode": "choice",
  "tier": "hard",
  "title": "What does this return?",
  "topics": [
    "as",
    "DateTime"
  ],
  "examObjective": "Converting between output types and data types using DataWeave",
  "prompt": "Read the script and the payload. **What does it return?**",
  "inputMime": "application/json",
  "outputMime": "application/json",
  "given": {
    "script": "%dw 2.0\noutput application/json\n---\npayload.at as DateTime",
    "payload": "{\"at\":\"2024-01-15T10:00:00\"}"
  },
  "choice": {
    "kind": "which-output",
    "answer": 3,
    "options": [
      "\"2024-01-15\"",
      "\"2024-01-15T10:00:00\"",
      "It fails: the String has no time zone",
      "\"2024-01-15T10:00:00Z\""
    ]
  },
  "cases": [],
  "solution": "%dw 2.0\noutput application/json\n---\npayload.at as DateTime",
  "explanation": {
    "approach": "When text without an offset is coerced to DateTime, the engine fills in UTC. The result is a DateTime and it prints with a Z.",
    "snippets": [
      {
        "label": "The answer",
        "script": "%dw 2.0\noutput application/json\n---\npayload.at as DateTime",
        "payload": "{\"at\":\"2024-01-15T10:00:00\"}",
        "expect": {
          "output": "\"2024-01-15T10:00:00Z\""
        },
        "note": "If the source time was local, the instant is now wrong by the local offset. Coerce to LocalDateTime when there is no zone."
      },
      {
        "label": "LocalDateTime keeps it zoneless",
        "script": "%dw 2.0\noutput application/json\n---\npayload.at as LocalDateTime",
        "payload": "{\"at\":\"2024-01-15T10:00:00\"}",
        "expect": {
          "output": "\"2024-01-15T10:00:00\""
        },
        "note": "No zone invented."
      }
    ]
  }
}
