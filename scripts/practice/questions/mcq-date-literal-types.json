{
  "id": "mcq-date-literal-types",
  "unit": "date-arithmetic",
  "mode": "choice",
  "tier": "medium",
  "title": "What does this return?",
  "topics": [
    "typeOf",
    "DateTime",
    "LocalDateTime"
  ],
  "examObjective": "Converting between output types and data types using DataWeave",
  "prompt": "Read the script. **What does it return?**",
  "inputMime": "application/json",
  "outputMime": "application/json",
  "given": {
    "script": "%dw 2.0\noutput application/json\n---\n[ typeOf(|2024-01-15T10:00|), typeOf(|2024-01-15T10:00:00Z|), typeOf(|10:00|) ]"
  },
  "choice": {
    "kind": "which-output",
    "answer": 3,
    "options": [
      "[ \"DateTime\", \"LocalDateTime\", \"LocalTime\" ]",
      "[ \"LocalDateTime\", \"DateTime\", \"Time\" ]",
      "[ \"DateTime\", \"DateTime\", \"Time\" ]",
      "[ \"LocalDateTime\", \"DateTime\", \"LocalTime\" ]"
    ]
  },
  "cases": [],
  "solution": "%dw 2.0\noutput application/json\n---\n[ typeOf(|2024-01-15T10:00|), typeOf(|2024-01-15T10:00:00Z|), typeOf(|10:00|) ]",
  "explanation": {
    "approach": "A date-time without a zone is a LocalDateTime. Adding a zone or offset makes it a DateTime. A time with no zone is a LocalTime.",
    "snippets": [
      {
        "label": "The answer",
        "script": "%dw 2.0\noutput application/json\n---\n[ typeOf(|2024-01-15T10:00|), typeOf(|2024-01-15T10:00:00Z|), typeOf(|10:00|) ]",
        "expect": {
          "output": "[ \"LocalDateTime\", \"DateTime\", \"LocalTime\" ]"
        },
        "note": "The zone decides the type."
      }
    ]
  }
}
